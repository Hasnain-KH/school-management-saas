# Required by the backend. Set real values in this private local file.
NODE_ENV=development
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Required in production; local development/tests may use the process-local limiter.
RATE_LIMIT_REDIS_URL=

# Optional. Comma-separated exact frontend origins allowed by CORS.
# CORS_ORIGINS=http://localhost:5173
# Optional. Public base URL used to build links inside emails.
# APP_BASE_URL=http://localhost:5173

# Optional email delivery (leave blank to keep email workflows disabled with a 503).
# EMAIL_API_KEY=
# EMAIL_FROM=
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_REPLY_TO=

# Optional S3-compatible document storage (leave blank to keep uploads disabled with a 503).
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=us-east-1
# STORAGE_FORCE_PATH_STYLE=true

# Optional scheduled jobs. Create the default subscription plans on startup.
# SEED_DEFAULT_PLANS=true
# Shared secret required to call POST /api/v1/jobs/run from an external scheduler.
# JOBS_RUNNER_SECRET=
# Local development only: run an in-process scheduler (never enable in production).
# ENABLE_DEV_SCHEDULER=true
# DEV_SCHEDULER_INTERVAL_MS=86400000
